{
  "name": "@lumi/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --entryFile ../apps/api/src/main",
    "build": "nest build",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test tests/*.spec.ts",
    "test:integration": "node tests/integration-smoke.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@lumi/contracts": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "catalog:",
    "@prisma/client": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "fastify": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:"
  }
}
