generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AccountDeletionStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum DataExportStatus {
  REQUESTED
  PROCESSING
  READY
  EXPIRED
  FAILED
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum NotificationType {
  SYSTEM
  MODERATION
  GENERATION
  FOLLOW
  INTERACTION
}

enum AnnouncementStatus {
  DRAFT
  SENDING
  SENT
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  REJECTED
  EXPIRED
  DELETED
}

enum MediaReviewStatus {
  UNREVIEWED
  APPROVED
  REJECTED
}

enum QuotaReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum QuotaEventType {
  GRANT
  RESERVE
  COMMIT
  RELEASE
}

model User {
  id                       String                    @id @default(cuid())
  wxOpenId                 String                    @unique @map("wx_open_id")
  status                   UserStatus                @default(ACTIVE)
  role                     UserRole                  @default(USER)
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  profiles                 BodyProfile[]
  assets                   MediaAsset[]
  jobs                     GenerationJob[]
  posts                    Post[]
  comments                 Comment[]
  sessions                 UserSession[]
  clothingItems            ClothingItem[]
  moderationActions        ModerationAction[]        @relation("ModerationActor")
  userModerationActions    UserModerationAction[]    @relation("UserModerationSubject")
  performedUserActions     UserModerationAction[]    @relation("UserModerationActor")
  mutes                    UserMute[]                @relation("UserMuteSubject")
  issuedMutes              UserMute[]                @relation("UserMuteActor")
  revokedMutes             UserMute[]                @relation("UserMuteRevoker")
  mediaReviewActions       MediaReviewAction[]       @relation("MediaReviewActor")
  likes                    PostLike[]
  bookmarks                PostBookmark[]
  reports                  PostReport[]
  resolvedReports          PostReport[]              @relation("ReportResolver")
  notifications            Notification[]
  commentModerationActions CommentModerationAction[]
  adminCredential          AdminCredential?
  quotaAccount             QuotaAccount?
  following                Follow[]                  @relation("Follower")
  followers                Follow[]                  @relation("Following")
  accountDeletion          AccountDeletionRequest?
  dataExports              DataExportRequest[]
  announcements            Announcement[]            @relation("AnnouncementAuthor")
  announcementRecipients   AnnouncementRecipient[]
  createdChallenges        Challenge[]               @relation("ChallengeCreator")
  challengeParticipants    ChallengeParticipant[]

  @@map("users")
}

model UserSession {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  refreshTokenHash    String    @unique @map("refresh_token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id")
  lastUsedAt          DateTime? @map("last_used_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model AccountDeletionRequest {
  id           String                 @id @default(cuid())
  userId       String                 @unique @map("user_id")
  status       AccountDeletionStatus  @default(REQUESTED)
  requestedAt  DateTime               @default(now()) @map("requested_at")
  scheduledFor DateTime               @map("scheduled_for")
  startedAt    DateTime?              @map("started_at")
  completedAt  DateTime?              @map("completed_at")
  cancelledAt  DateTime?              @map("cancelled_at")
  failureCode  String?                @map("failure_code")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       AccountDeletionEvent[]

  @@index([status, scheduledFor])
  @@map("account_deletion_requests")
}

model AccountDeletionEvent {
  id         String                 @id @default(cuid())
  requestId  String                 @map("request_id")
  fromStatus AccountDeletionStatus? @map("from_status")
  toStatus   AccountDeletionStatus  @map("to_status")
  actorType  String                 @map("actor_type")
  actorId    String?                @map("actor_id")
  metadata   Json?
  createdAt  DateTime               @default(now()) @map("created_at")
  request    AccountDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("account_deletion_events")
}

model DataExportRequest {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  status       DataExportStatus @default(REQUESTED)
  requestedAt  DateTime         @default(now()) @map("requested_at")
  processingAt DateTime?        @map("processing_at")
  readyAt      DateTime?        @map("ready_at")
  expiresAt    DateTime?        @map("expires_at")
  failureCode  String?          @map("failure_code")
  payload      Json?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("data_export_requests")
}

model AdminCredential {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  username     String    @unique
  passwordHash String    @map("password_hash")
  disabledAt   DateTime? @map("disabled_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_credentials")
}

model UserModerationAction {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  actorId    String?    @map("actor_id")
  fromStatus UserStatus @map("from_status")
  toStatus   UserStatus @map("to_status")
  fromRole   UserRole   @map("from_role")
  toRole     UserRole   @map("to_role")
  reason     String
  createdAt  DateTime   @default(now()) @map("created_at")
  user       User       @relation("UserModerationSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?      @relation("UserModerationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@map("user_moderation_actions")
}

model UserMute {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  actorId     String?   @map("actor_id")
  reason      String
  startsAt    DateTime  @default(now()) @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation("UserMuteSubject", fields: [userId], references: [id], onDelete: Cascade)
  actor       User?     @relation("UserMuteActor", fields: [actorId], references: [id], onDelete: SetNull)
  revokedBy   User?     @relation("UserMuteRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, startsAt, endsAt, revokedAt])
  @@index([actorId, createdAt])
  @@map("user_mutes")
}

model BodyProfile {
  id            String               @id @default(cuid())
  userId        String               @map("user_id")
  name          String
  activeVersion Int                  @default(1) @map("active_version")
  archivedAt    DateTime?            @map("archived_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions      BodyProfileVersion[]

  @@index([userId, updatedAt])
  @@map("body_profiles")
}

model BodyProfileVersion {
  id            String          @id @default(cuid())
  profileId     String          @map("profile_id")
  version       Int
  measurements  Json
  sourceAssetId String?         @map("source_asset_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  profile       BodyProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobs          GenerationJob[]

  @@unique([profileId, version])
  @@map("body_profile_versions")
}

model MediaAsset {
  id                  String              @id @default(cuid())
  ownerId             String              @map("owner_id")
  objectKey           String              @unique @map("object_key")
  storageDriver       String              @default("local") @map("storage_driver")
  status              MediaStatus         @default(READY)
  reviewStatus        MediaReviewStatus   @default(UNREVIEWED) @map("review_status")
  reviewReason        String?             @map("review_reason")
  reviewedAt          DateTime?           @map("reviewed_at")
  reviewedById        String?             @map("reviewed_by_id")
  stagingObjectKey    String?             @unique @map("staging_object_key")
  uploadRequestKey    String?             @map("upload_request_key")
  uploadMimeType      String?             @map("upload_mime_type")
  uploadByteSize      Int?                @map("upload_byte_size")
  uploadExpiresAt     DateTime?           @map("upload_expires_at")
  processingToken     String?             @map("processing_token")
  processingStartedAt DateTime?           @map("processing_started_at")
  width               Int?
  height              Int?
  mimeType            String              @map("mime_type")
  byteSize            Int                 @map("byte_size")
  sha256              String
  visibility          String              @default("PRIVATE")
  previewData         String?             @map("preview_data") @db.Text
  deletedAt           DateTime?           @map("deleted_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  owner               User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  generationOutputs   GenerationOutput[]
  reviewActions       MediaReviewAction[]

  @@unique([ownerId, uploadRequestKey])
  @@index([ownerId, createdAt])
  @@index([status, uploadExpiresAt])
  @@index([reviewStatus, createdAt])
  @@map("media_assets")
}

model MediaReviewAction {
  id         String            @id @default(cuid())
  assetId    String            @map("asset_id")
  actorId    String            @map("actor_id")
  fromStatus MediaReviewStatus @map("from_status")
  toStatus   MediaReviewStatus @map("to_status")
  reason     String?
  createdAt  DateTime          @default(now()) @map("created_at")
  asset      MediaAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actor      User              @relation("MediaReviewActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([assetId, createdAt])
  @@index([actorId, createdAt])
  @@map("media_review_actions")
}

model ObjectCleanup {
  id            String   @id @default(cuid())
  objectKey     String   @unique @map("object_key")
  notBefore     DateTime @map("not_before")
  attempts      Int      @default(0)
  lastErrorCode String?  @map("last_error_code")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([notBefore])
  @@map("object_cleanup")
}

model ClothingItem {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  name      String
  category  String
  color     String?
  style     String?
  assetId   String?         @map("asset_id")
  deletedAt DateTime?       @map("deleted_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs      GenerationJob[]

  @@index([userId, updatedAt])
  @@map("clothing_items")
}

model GenerationJob {
  id                String              @id @default(cuid())
  userId            String              @map("user_id")
  profileVersionId  String              @map("profile_version_id")
  clothingAssetId   String              @map("clothing_asset_id")
  idempotencyKey    String              @map("idempotency_key")
  status            GenerationJobStatus @default(QUEUED)
  provider          String              @default("local")
  retryCount        Int                 @default(0) @map("retry_count")
  quotaAttempt      Int                 @default(0) @map("quota_attempt")
  inputSnapshot     Json?               @map("input_snapshot")
  executionToken    String?             @map("execution_token")
  leaseExpiresAt    DateTime?           @map("lease_expires_at")
  errorCode         String?             @map("error_code")
  nextAttemptAt     DateTime?           @default(now()) @map("next_attempt_at")
  startedAt         DateTime?           @map("started_at")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVersion    BodyProfileVersion  @relation(fields: [profileVersionId], references: [id])
  clothingAsset     ClothingItem        @relation(fields: [clothingAssetId], references: [id])
  outputs           GenerationOutput[]
  quotaReservations QuotaReservation[]

  @@unique([userId, idempotencyKey])
  @@unique([id, userId])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([userId, status, createdAt])
  @@map("generation_jobs")
}

model QuotaAccount {
  userId        String             @id @map("user_id")
  available     Int
  reserved      Int                @default(0)
  consumed      Int                @default(0)
  granted       Int
  policyVersion String             @default("free-trial-v1") @map("policy_version")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations  QuotaReservation[]
  ledger        QuotaLedger[]

  @@map("quota_accounts")
}

model QuotaReservation {
  id        String                 @id @default(cuid())
  jobId     String                 @map("job_id")
  userId    String                 @map("user_id")
  attempt   Int
  status    QuotaReservationStatus @default(RESERVED)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  job       GenerationJob          @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  account   QuotaAccount           @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([jobId, attempt])
  @@index([userId, status])
  @@map("quota_reservations")
}

model QuotaLedger {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  jobId          String?        @map("job_id")
  attempt        Int?
  eventKey       String         @unique @map("event_key")
  type           QuotaEventType
  deltaAvailable Int            @map("delta_available")
  deltaReserved  Int            @map("delta_reserved")
  deltaConsumed  Int            @map("delta_consumed")
  createdAt      DateTime       @default(now()) @map("created_at")
  account        QuotaAccount   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([jobId])
  @@map("quota_ledger")
}

model GenerationOutput {
  id         String        @id @default(cuid())
  jobId      String        @map("job_id")
  assetId    String        @map("asset_id")
  selectedAt DateTime?     @map("selected_at")
  savedAt    DateTime?     @map("saved_at")
  deletedAt  DateTime?     @map("deleted_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  job        GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  asset      MediaAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([jobId, assetId])
  @@index([jobId, createdAt])
  @@index([assetId, deletedAt])
  @@map("generation_outputs")
}

model Post {
  id                String             @id @default(cuid())
  authorId          String             @map("author_id")
  title             String
  body              String
  idempotencyKey    String?            @map("idempotency_key")
  requestHash       String?            @map("request_hash")
  imageAssetIds     Json               @default("[]") @map("image_asset_ids")
  topic             String?
  challengeId       String?            @map("challenge_id")
  isAiGenerated     Boolean            @default(false) @map("is_ai_generated")
  featuredAt        DateTime?          @map("featured_at")
  moderationStatus  ModerationStatus   @default(PENDING) @map("moderation_status")
  deletedAt         DateTime?          @map("deleted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  author            User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments          Comment[]
  moderationActions ModerationAction[]
  likes             PostLike[]
  bookmarks         PostBookmark[]
  reports           PostReport[]
  challenge         Challenge?         @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@unique([authorId, idempotencyKey])
  @@index([moderationStatus, createdAt])
  @@index([topic, moderationStatus, createdAt])
  @@index([challengeId, moderationStatus, createdAt])
  @@index([authorId, createdAt])
  @@index([imageAssetIds], type: Gin)
  @@map("posts")
}

model Challenge {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  title        String
  description  String
  status       ChallengeStatus        @default(DRAFT)
  startsAt     DateTime               @map("starts_at")
  endsAt       DateTime               @map("ends_at")
  createdById  String                 @map("created_by_id")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  creator      User                   @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  posts        Post[]
  participants ChallengeParticipant[]

  @@index([status, startsAt, endsAt])
  @@map("challenges")
}

model ChallengeParticipant {
  challengeId String    @map("challenge_id")
  userId      String    @map("user_id")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  leftAt      DateTime? @map("left_at")
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId, leftAt, joinedAt])
  @@map("challenge_participants")
}

model ModerationAction {
  id         String           @id @default(cuid())
  postId     String           @map("post_id")
  actorId    String           @map("actor_id")
  fromStatus ModerationStatus @map("from_status")
  toStatus   ModerationStatus @map("to_status")
  reason     String?
  createdAt  DateTime         @default(now()) @map("created_at")
  post       Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor      User             @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([actorId, createdAt])
  @@map("moderation_actions")
}

model Comment {
  id                String                    @id @default(cuid())
  postId            String                    @map("post_id")
  authorId          String                    @map("author_id")
  body              String
  parentId          String?                   @map("parent_id")
  moderationStatus  ModerationStatus          @default(PENDING) @map("moderation_status")
  createdAt         DateTime                  @default(now()) @map("created_at")
  post              Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author            User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  moderationActions CommentModerationAction[]

  @@index([postId, createdAt])
  @@map("comments")
}

model CommentModerationAction {
  id         String           @id @default(cuid())
  commentId  String           @map("comment_id")
  actorId    String           @map("actor_id")
  fromStatus ModerationStatus @map("from_status")
  toStatus   ModerationStatus @map("to_status")
  reason     String?
  createdAt  DateTime         @default(now()) @map("created_at")
  comment    Comment          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  actor      User             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([commentId, createdAt])
  @@map("comment_moderation_actions")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("post_likes")
}

model PostBookmark {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("post_bookmarks")
}

model PostReport {
  id               String       @id @default(cuid())
  postId           String       @map("post_id")
  reporterId       String       @map("reporter_id")
  resolvedById     String?      @map("resolved_by_id")
  reason           String
  status           ReportStatus @default(OPEN)
  resolutionReason String?      @map("resolution_reason")
  createdAt        DateTime     @default(now()) @map("created_at")
  resolvedAt       DateTime?    @map("resolved_at")
  post             Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter         User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy       User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([postId, createdAt])
  @@map("post_reports")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  body       String
  targetType String?          @map("target_type")
  targetId   String?          @map("target_id")
  commentId  String?          @map("comment_id")
  eventKey   String?          @unique @map("event_key")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Announcement {
  id             String                  @id @default(cuid())
  authorId       String?                 @map("author_id")
  idempotencyKey String                  @map("idempotency_key")
  title          String
  body           String
  status         AnnouncementStatus      @default(DRAFT)
  version        Int                     @default(1)
  recipientCount Int?                    @map("recipient_count")
  publishedAt    DateTime?               @map("published_at")
  sentAt         DateTime?               @map("sent_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  author         User?                   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  recipients     AnnouncementRecipient[]

  @@unique([authorId, idempotencyKey])
  @@index([status, publishedAt, id])
  @@index([createdAt, id])
  @@map("announcements")
}

model AnnouncementRecipient {
  announcementId String       @map("announcement_id")
  userId         String       @map("user_id")
  deliveredAt    DateTime?    @map("delivered_at")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([announcementId, deliveredAt, userId])
  @@index([userId, announcementId])
  @@map("announcement_recipients")
}

model RuntimeConfig {
  id        String   @id @default(cuid())
  configKey String   @map("config_key")
  version   Int
  value     Json
  reason    String
  actorId   String   @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([configKey, version])
  @@index([configKey, createdAt])
  @@map("runtime_configs")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt, id])
  @@index([followerId, createdAt, id])
  @@map("follows")
}
