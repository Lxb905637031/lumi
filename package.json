{
  "name": "lumi",
  "private": true,
  "version": "0.1.0",
  "description": "Lumi AI styling and content community",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:api": "pnpm --filter @lumi/api dev",
    "dev:miniapp": "pnpm --filter @lumi/miniapp dev:weapp",
    "dev:admin": "pnpm --filter @lumi/admin dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @lumi/api db:generate",
    "db:push": "pnpm --filter @lumi/api db:push",
    "db:migrate": "pnpm --filter @lumi/api db:migrate",
    "db:deploy": "pnpm --filter @lumi/api db:deploy",
    "db:adopt-baseline": "pnpm --filter @lumi/api db:adopt-baseline",
    "test:migrations": "pnpm --filter @lumi/api test:migrations",
    "backup:local": "node --env-file-if-exists=.env scripts/backup-local.mjs",
    "restore:local": "node --env-file-if-exists=.env scripts/restore-local.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
