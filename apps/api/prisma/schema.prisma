generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum NotificationType {
  SYSTEM
  MODERATION
  GENERATION
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  REJECTED
  EXPIRED
  DELETED
}

enum QuotaReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum QuotaEventType {
  GRANT
  RESERVE
  COMMIT
  RELEASE
}

model User {
  id                       String                    @id @default(cuid())
  wxOpenId                 String                    @unique @map("wx_open_id")
  status                   UserStatus                @default(ACTIVE)
  role                     UserRole                  @default(USER)
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  profiles                 BodyProfile[]
  assets                   MediaAsset[]
  jobs                     GenerationJob[]
  posts                    Post[]
  comments                 Comment[]
  sessions                 UserSession[]
  clothingItems            ClothingItem[]
  moderationActions        ModerationAction[]        @relation("ModerationActor")
  likes                    PostLike[]
  bookmarks                PostBookmark[]
  reports                  PostReport[]
  notifications            Notification[]
  commentModerationActions CommentModerationAction[]
  adminCredential          AdminCredential?
  quotaAccount             QuotaAccount?

  @@map("users")
}

model UserSession {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  refreshTokenHash    String    @unique @map("refresh_token_hash")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id")
  lastUsedAt          DateTime? @map("last_used_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model AdminCredential {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  username     String    @unique
  passwordHash String    @map("password_hash")
  disabledAt   DateTime? @map("disabled_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_credentials")
}

model BodyProfile {
  id            String               @id @default(cuid())
  userId        String               @map("user_id")
  name          String
  activeVersion Int                  @default(1) @map("active_version")
  archivedAt    DateTime?            @map("archived_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions      BodyProfileVersion[]

  @@index([userId, updatedAt])
  @@map("body_profiles")
}

model BodyProfileVersion {
  id            String          @id @default(cuid())
  profileId     String          @map("profile_id")
  version       Int
  measurements  Json
  sourceAssetId String?         @map("source_asset_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  profile       BodyProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobs          GenerationJob[]

  @@unique([profileId, version])
  @@map("body_profile_versions")
}

model MediaAsset {
  id                  String             @id @default(cuid())
  ownerId             String             @map("owner_id")
  objectKey           String             @unique @map("object_key")
  storageDriver       String             @default("local") @map("storage_driver")
  status              MediaStatus        @default(READY)
  stagingObjectKey    String?            @unique @map("staging_object_key")
  uploadRequestKey    String?            @map("upload_request_key")
  uploadMimeType      String?            @map("upload_mime_type")
  uploadByteSize      Int?               @map("upload_byte_size")
  uploadExpiresAt     DateTime?          @map("upload_expires_at")
  processingToken     String?            @map("processing_token")
  processingStartedAt DateTime?          @map("processing_started_at")
  width               Int?
  height              Int?
  mimeType            String             @map("mime_type")
  byteSize            Int                @map("byte_size")
  sha256              String
  visibility          String             @default("PRIVATE")
  previewData         String?            @map("preview_data") @db.Text
  deletedAt           DateTime?          @map("deleted_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  owner               User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  generationOutputs   GenerationOutput[]

  @@unique([ownerId, uploadRequestKey])
  @@index([ownerId, createdAt])
  @@index([status, uploadExpiresAt])
  @@map("media_assets")
}

model ObjectCleanup {
  id            String   @id @default(cuid())
  objectKey     String   @unique @map("object_key")
  notBefore     DateTime @map("not_before")
  attempts      Int      @default(0)
  lastErrorCode String?  @map("last_error_code")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([notBefore])
  @@map("object_cleanup")
}

model ClothingItem {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  name      String
  category  String
  color     String?
  style     String?
  assetId   String?         @map("asset_id")
  deletedAt DateTime?       @map("deleted_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs      GenerationJob[]

  @@index([userId, updatedAt])
  @@map("clothing_items")
}

model GenerationJob {
  id                String              @id @default(cuid())
  userId            String              @map("user_id")
  profileVersionId  String              @map("profile_version_id")
  clothingAssetId   String              @map("clothing_asset_id")
  idempotencyKey    String              @map("idempotency_key")
  status            GenerationJobStatus @default(QUEUED)
  provider          String              @default("local")
  retryCount        Int                 @default(0) @map("retry_count")
  quotaAttempt      Int                 @default(0) @map("quota_attempt")
  inputSnapshot     Json?               @map("input_snapshot")
  executionToken    String?             @map("execution_token")
  leaseExpiresAt    DateTime?           @map("lease_expires_at")
  errorCode         String?             @map("error_code")
  nextAttemptAt     DateTime?           @default(now()) @map("next_attempt_at")
  startedAt         DateTime?           @map("started_at")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileVersion    BodyProfileVersion  @relation(fields: [profileVersionId], references: [id])
  clothingAsset     ClothingItem        @relation(fields: [clothingAssetId], references: [id])
  outputs           GenerationOutput[]
  quotaReservations QuotaReservation[]

  @@unique([userId, idempotencyKey])
  @@unique([id, userId])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([userId, status, createdAt])
  @@map("generation_jobs")
}

model QuotaAccount {
  userId        String             @id @map("user_id")
  available     Int
  reserved      Int                @default(0)
  consumed      Int                @default(0)
  granted       Int
  policyVersion String             @default("free-trial-v1") @map("policy_version")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations  QuotaReservation[]
  ledger        QuotaLedger[]

  @@map("quota_accounts")
}

model QuotaReservation {
  id        String                 @id @default(cuid())
  jobId     String                 @map("job_id")
  userId    String                 @map("user_id")
  attempt   Int
  status    QuotaReservationStatus @default(RESERVED)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  job       GenerationJob          @relation(fields: [jobId, userId], references: [id, userId], onDelete: Cascade)
  account   QuotaAccount           @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([jobId, attempt])
  @@index([userId, status])
  @@map("quota_reservations")
}

model QuotaLedger {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  jobId          String?        @map("job_id")
  attempt        Int?
  eventKey       String         @unique @map("event_key")
  type           QuotaEventType
  deltaAvailable Int            @map("delta_available")
  deltaReserved  Int            @map("delta_reserved")
  deltaConsumed  Int            @map("delta_consumed")
  createdAt      DateTime       @default(now()) @map("created_at")
  account        QuotaAccount   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([jobId])
  @@map("quota_ledger")
}

model GenerationOutput {
  id         String        @id @default(cuid())
  jobId      String        @map("job_id")
  assetId    String        @map("asset_id")
  selectedAt DateTime?     @map("selected_at")
  savedAt    DateTime?     @map("saved_at")
  deletedAt  DateTime?     @map("deleted_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  job        GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  asset      MediaAsset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([jobId, assetId])
  @@index([jobId, createdAt])
  @@map("generation_outputs")
}

model Post {
  id                String             @id @default(cuid())
  authorId          String             @map("author_id")
  title             String
  body              String
  imageAssetIds     Json               @default("[]") @map("image_asset_ids")
  topic             String?
  isAiGenerated     Boolean            @default(false) @map("is_ai_generated")
  featuredAt        DateTime?          @map("featured_at")
  moderationStatus  ModerationStatus   @default(PENDING) @map("moderation_status")
  deletedAt         DateTime?          @map("deleted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  author            User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments          Comment[]
  moderationActions ModerationAction[]
  likes             PostLike[]
  bookmarks         PostBookmark[]
  reports           PostReport[]

  @@index([moderationStatus, createdAt])
  @@index([topic, moderationStatus, createdAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

model ModerationAction {
  id         String           @id @default(cuid())
  postId     String           @map("post_id")
  actorId    String           @map("actor_id")
  fromStatus ModerationStatus @map("from_status")
  toStatus   ModerationStatus @map("to_status")
  reason     String?
  createdAt  DateTime         @default(now()) @map("created_at")
  post       Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor      User             @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([actorId, createdAt])
  @@map("moderation_actions")
}

model Comment {
  id                String                    @id @default(cuid())
  postId            String                    @map("post_id")
  authorId          String                    @map("author_id")
  body              String
  parentId          String?                   @map("parent_id")
  moderationStatus  ModerationStatus          @default(PENDING) @map("moderation_status")
  createdAt         DateTime                  @default(now()) @map("created_at")
  post              Post                      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author            User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  moderationActions CommentModerationAction[]

  @@index([postId, createdAt])
  @@map("comments")
}

model CommentModerationAction {
  id         String           @id @default(cuid())
  commentId  String           @map("comment_id")
  actorId    String           @map("actor_id")
  fromStatus ModerationStatus @map("from_status")
  toStatus   ModerationStatus @map("to_status")
  reason     String?
  createdAt  DateTime         @default(now()) @map("created_at")
  comment    Comment          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  actor      User             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([commentId, createdAt])
  @@map("comment_moderation_actions")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("post_likes")
}

model PostBookmark {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("post_bookmarks")
}

model PostReport {
  id         String       @id @default(cuid())
  postId     String       @map("post_id")
  reporterId String       @map("reporter_id")
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([postId, createdAt])
  @@map("post_reports")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  body       String
  targetType String?          @map("target_type")
  targetId   String?          @map("target_id")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
