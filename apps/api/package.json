{
  "name": "@lumi/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --entryFile ../apps/api/src/main",
    "build": "nest build",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test tests/*.spec.ts",
    "test:integration": "node --env-file-if-exists=../../.env tests/integration-smoke.mjs",
    "test:migrations": "node --env-file-if-exists=../../.env tests/migrations.mjs",
    "test:storage": "node --env-file-if-exists=../../.env tests/storage-integration.mjs",
    "test:quota": "node --env-file-if-exists=../../.env --import tsx --test tests/quota.integration.ts",
    "test:try-on-client": "node --env-file-if-exists=../../.env --import tsx tests/try-on-client.integration.mjs",
    "storage:init-local": "node --env-file-if-exists=../../.env scripts/init-local-storage.mjs",
    "db:generate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "db:push": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js db push --schema prisma/schema.prisma",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "db:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "db:adopt-baseline": "node --env-file-if-exists=../../.env scripts/adopt-baseline.mjs",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@lumi/contracts": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "catalog:",
    "bullmq": "^6.3.16",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "fastify": "catalog:",
    "ioredis": "^6.0.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:"
  }
}
